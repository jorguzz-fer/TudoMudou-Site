# Imagem dedicada para estudos.tudomudou.com.br
# No Coolify: Build Pack = Dockerfile, Dockerfile location = /Dockerfile.estudos
FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx-estudos.conf /etc/nginx/conf.d/default.conf
COPY estudos/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
